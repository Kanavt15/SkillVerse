# ─── Dependencies ────────────────────────────────────────────
node_modules/

# ─── Secrets (NEVER commit these) ────────────────────────────
# Local Worker secrets are generated by `npm run setup`.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# ─── Cloudflare / Wrangler local state ───────────────────────
# The local D1 database, KV, R2 and Durable Object data live here.
.wrangler/
.mf/

# ─── Build output ────────────────────────────────────────────
dist/
build/
.react-router/
*.tsbuildinfo

# ─── Tests & coverage ────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ─── Logs & temp ─────────────────────────────────────────────
*.log
npm-debug.log*
tmp/

# ─── OS / editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
