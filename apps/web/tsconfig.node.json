{
  // Type settings for build tooling that runs in Node (Vite and test configs).
  "extends": "../../tsconfig.base.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tsbuild/node",
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  }
}
