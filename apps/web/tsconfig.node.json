{
  // Type settings for build tooling that runs in Node (Vite and test configs).
  "extends": "../../tsconfig.base.json",
  "include": ["vite.config.ts", "vitest.config.ts", "react-router.config.ts"],
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tsbuild/node",
    "types": ["node"]
  }
}
