{
  "name": "@skillverse/web",
  "version": "0.0.0",
  "private": true,
  "description": "SkillVerse website: React Router (SSR) running on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5173 --strictPort",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "typecheck": "react-router typegen && tsc -b",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler deploy --env production",
    "deploy:staging": "npm run build && wrangler deploy --env staging"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.57.3",
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.136.3"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@skillverse/shared": "^0.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.2.2",
    "lucide-react": "^1.47.0",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  }
}
