/**
 * Cloudflare Worker configuration for the SkillVerse API.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * The TOP-LEVEL settings are used for local development (`npm run dev`).
 * `env.staging` and `env.production` override them for deployments. Bindings
 * environments, so each environment lists its own.
 *
 * Before the first deploy, replace every "REPLACE_WITH_…" value with the IDs
 * printed by the commands in docs/operations/deployment.md.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "account_id": "822066940d2a213f84c56141779e87ef",
  "name": "skillverse-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NOTIFICATIONS",
        "class_name": "NotificationHub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-notification-hub",
      "new_sqlite_classes": ["NotificationHub"],
    },
  ],
  // Non-secret configuration. Secrets go in .dev.vars (local) or `wrangler secret put` (deployed).
  "vars": {
    "ENVIRONMENT": "development",
    // Comma-separated origins allowed to make state-changing requests (CSRF check).
    "APP_ORIGINS": "http://localhost:5173",
    // Sender for transactional email (must be a domain verified in Resend when deployed).
    "EMAIL_FROM": "SkillVerse <no-reply@skillverse.test>",
    // "on" rejects passwords found in data breaches (HIBP). Off locally so dev works offline.
    "PASSWORD_BREACH_CHECK": "off",
    // Google OAuth client ID (public). Empty = "Continue with Google" is hidden. See docs/guides/google-sign-in.md.
    "GOOGLE_CLIENT_ID": "",
    // "off" lets demo admins use admin pages without 2FA. NEVER "off" outside local development.
    "ENFORCE_ADMIN_MFA": "off",
    "OPERATIONS_TELEMETRY": "off",
    "WEB_PROXY_MODE": "off",
    "SETU_ENVIRONMENT": "sandbox",
  },
  // D1 = the SQL database. `binding` is the name the code uses: env.DB.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skillverse-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  // Built-in rate limiters. `period` must be 10 or 60 seconds.
  "ratelimits": [
    {
      "name": "RL_API",
      "namespace_id": "1001",
      "simple": {
        "limit": 300,
        "period": 60,
      },
    },
    {
      "name": "RL_AUTH",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "env": {
    "staging": {
      "name": "skillverse-api-staging",
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "NOTIFICATIONS",
            "class_name": "NotificationHub",
          },
        ],
      },
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_LAUNCH_READY": "off",
        "APP_ORIGINS": "https://skillverse-kanavt15.vercel.app",
        "EMAIL_FROM": "SkillVerse <no-reply@REPLACE_WITH_DOMAIN>",
        "PASSWORD_BREACH_CHECK": "on",
        "GOOGLE_CLIENT_ID": "",
        "ENFORCE_ADMIN_MFA": "on",
        "OPERATIONS_TELEMETRY": "on",
        "WEB_PROXY_MODE": "vercel",
        "SETU_ENVIRONMENT": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "skillverse-staging",
          "database_id": "94a3e213-ad4e-42a3-8277-0c8155603ad6",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "RL_API",
          "namespace_id": "2001",
          "simple": {
            "limit": 300,
            "period": 60,
          },
        },
        {
          "name": "RL_AUTH",
          "namespace_id": "2002",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
    },
    "production": {
      "name": "skillverse-api",
      "triggers": {
        "crons": ["*/5 * * * *"],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "NOTIFICATIONS",
            "class_name": "NotificationHub",
          },
        ],
      },
      // Serve the API on the same origin as the website: https://<domain>/api/*
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_LAUNCH_READY": "off",
        "APP_ORIGINS": "https://skillverse-kanavt15.vercel.app",
        "EMAIL_FROM": "SkillVerse <no-reply@REPLACE_WITH_DOMAIN>",
        "PASSWORD_BREACH_CHECK": "on",
        "GOOGLE_CLIENT_ID": "",
        "ENFORCE_ADMIN_MFA": "on",
        "OPERATIONS_TELEMETRY": "on",
        "WEB_PROXY_MODE": "vercel",
        "SETU_ENVIRONMENT": "production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "skillverse-prod",
          "database_id": "d2381b82-cf90-4467-8cfb-23b5a8911446",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "RL_API",
          "namespace_id": "3001",
          "simple": {
            "limit": 300,
            "period": 60,
          },
        },
        {
          "name": "RL_AUTH",
          "namespace_id": "3002",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
    },
  },
}
