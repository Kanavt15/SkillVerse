{
  "name": "@skillverse/api",
  "version": "0.0.0",
  "private": true,
  "description": "SkillVerse HTTP API: a Hono app running on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf-typegen": "wrangler types --strict-vars=false",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.4",
    "@skillverse/db": "*",
    "@skillverse/shared": "*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.136.3"
  }
}
