# Server Configuration
PORT=5000
NODE_ENV=development

# ============================================================
# MongoDB Configuration
# ============================================================
# IMPORTANT: SkillVerse uses multi-document transactions (enrollment, lesson
# completion, payments). These REQUIRE a replica set — they do not work against
# a standalone mongod. Atlas is a replica set by default.
#
# Local development, single-node replica set:
#   mongod --replSet rs0 --dbpath ./data
#   mongosh --eval "rs.initiate()"
# Then use: mongodb://localhost:27017/skillverse?replicaSet=rs0
#
# Or just run `docker compose up mongo`, which sets this up for you.
MONGODB_URI=mongodb://localhost:27017/skillverse?replicaSet=rs0

# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillverse?retryWrites=true&w=majority

# Set to true to log every Mongoose query (development only)
MONGO_DEBUG=false

# ============================================================
# Legacy MySQL — being removed
# ============================================================
# Still read by controllers not yet ported to MongoDB. Delete this block, and
# config/database.js, once the last controller is migrated.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password_here
DB_NAME=skillverse
DB_PORT=3306
# DB_SSL=true                    # Enable for production

# ============================================================
# JWT Configuration
# ============================================================
# IMPORTANT: Generate a strong, unique secret for production!
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Refresh Token Configuration
# Access tokens are fixed at 15 minutes, refresh tokens default to 7 days
REFRESH_TOKEN_EXPIRY_DAYS=7

# ============================================================
# Code Execution (Judge0)
# ============================================================
# Hosted via RapidAPI, or point at a self-hosted Judge0 instance.
# User code is NEVER executed in this Node process.
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# Execution limits enforced per submission
JUDGE0_CPU_TIME_LIMIT=5
JUDGE0_MEMORY_LIMIT=128000
JUDGE0_MAX_OUTPUT_SIZE=65536

# ============================================================
# Redis (caching and distributed rate limiting) — optional
# ============================================================
# The app degrades gracefully if Redis is unavailable.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=skillverse:

# ============================================================
# Payments (Razorpay)
# ============================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================
# File Upload
# ============================================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ============================================================
# CORS
# ============================================================
CLIENT_URL=http://localhost:3000
